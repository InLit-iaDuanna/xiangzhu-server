# Frontend proxy; the backend must be reachable from the Sites runtime over HTTPS.
BUSINESS_API_URL=http://127.0.0.1:4100
# Independent backend. Use an operator-managed secret store in production.
DATABASE_URL=postgresql://xiangzhu:CHANGE_ME@localhost:5432/xiangzhu
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AUTH_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:3000
MATERIALS_DIR=work/materials
PORT=4100
HOST=127.0.0.1
# Only for creating the initial account; remove after bootstrap.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=

# Tencent Maps: server only. Never use a VITE_ or NEXT_PUBLIC_ prefix.
TENCENT_MAP_KEY=
TENCENT_MAP_SK=
# Server-side text AI. API is the default; CodeBuddy requires an explicit opt-in.
TEXT_AI_PROVIDER=openai-compatible
TEXT_API_PROTOCOL=responses
TEXT_API_BASE_URL=https://api.openai.com/v1
TEXT_API_KEY=
TEXT_API_MODEL=gpt-5.3-codex
TEXT_API_TIMEOUT_MS=300000
TEXT_API_ACTOR_AUTHORIZATION=
# Set TEXT_AI_PROVIDER=codebuddy to explicitly use the local CLI instead.
CODEBUDDY_MODEL=deepseek-v4-flash
CODEBUDDY_TIMEOUT_MS=240000
# Optional overrides for the CodeBuddy CLI channel.
CODEBUDDY_BIN=
CODEBUDDY_FALLBACK_MODEL=

# Legacy aliases retained for existing installations. TEXT_API_* takes precedence.
CODEX_API_KEY=
CODEX_API_BASE_URL=https://api.openai.com/v1
CODEX_API_MODEL=gpt-5.3-codex
CODEX_API_REASONING_EFFORT=minimal
# Legacy OPENAI_API_KEY is also accepted when TEXT_API_KEY/CODEX_API_KEY are unset.

# Independent image generation API. Keep credentials server-side.
IMAGE_EXECUTOR=openai-compatible
IMAGE_API_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_API_TIMEOUT_MS=180000
IMAGE_COUNT=4
IMAGE_API_ACTOR_AUTHORIZATION=
# For Chugao use IMAGE_EXECUTOR=chugao, IMAGE_API_BASE_URL=https://chugao.art/api/v1,
# IMAGE_API_KEY=cgapi_..., and a supported model such as gpt-image-2.
# 知识库目录（案例/规则数据；留空则用仓库内 knowledge/）
KNOWLEDGE_DIR=knowledge
# 可选：自建知识条目 JSON（旧格式，存在时合并进检索）
KNOWLEDGE_PATH=work/knowledge.json
# Explicit multimodal executor for private street photos.

# 监听
PORT=4100
HOST=0.0.0.0

# 嵌入式 postgres（pglite）：指向持久目录；设为 memory 则为内存模式（临时演示）
PGLITE_DATA_DIR=work/pglite-data

# CORS：允许的前端来源（逗号分隔）
WEB_ORIGINS=http://localhost:3000,http://172.16.x.x:3000

# 运行时数据目录
MATERIALS_DIR=work/materials
# 可选：知识库路径（不存在时返回空）
KNOWLEDGE_PATH=work/knowledge.json

# AI 执行器：codebuddy（本机 CodeBuddy CLI，需安装并登录）
AI_EXECUTOR=codebuddy
CODEBUDDY_MODEL=deepseek-v4-flash
CODEBUDDY_TIMEOUT_MS=240000
# 可选：CLI 覆盖
CODEBUDDY_BIN=
CODEBUDDY_FALLBACK_MODEL=

# 腾讯地图（仅服务端持有，切勿加 VITE_/NEXT_PUBLIC_ 前缀，切勿提交真实值）
TENCENT_MAP_KEY=
TENCENT_MAP_SK=

# 备用执行器 codex（AI_EXECUTOR=codex 时启用；密钥仅存本文件，不入库）
CODEX_API_KEY=
CODEX_API_BASE_URL=https://api.openai.com/v1
CODEX_API_MODEL=gpt-5.3-codex
CODEX_API_REASONING_EFFORT=minimal
